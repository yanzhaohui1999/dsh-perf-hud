{
  "name": "dsh-perf-hud",
  "version": "1.1.0",
  "description": "DSH 卡顿时,在页面内直接回答「刚才那一下多慢、卡在哪一层、是谁干的」,并把现场留给事后复盘。 Client-side performance recorder for DeepSeek Harness: how slow the last stall was, which layer caused it, who is to blame, and the evidence kept for replay.",
  "type": "module",
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.*.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "README_EN.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "tools",
    "skills",
    "REVIEW.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/attribution.mjs && node tests/logic.mjs && node tests/host.mjs && node tests/compat.mjs && node tools/render-smoke.mjs && node tests/replay.mjs",
    "docs:check": "node tools/check-docs.mjs",
    "pack:check": "node tools/check-pack.mjs",
    "readme:check": "node tools/check-readme-images.mjs",
    "prefix:gen": "node tools/gen-prefix-table.mjs",
    "prefix:check": "node tools/gen-prefix-table.mjs --check",
    "timeline:check": "node tools/check-timeline.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "performance",
    "profiler",
    "fps",
    "longtask",
    "long-task",
    "attribution",
    "observability",
    "hud",
    "devtools",
    "web"
  ],
  "author": {
    "name": "yanzhaohui1999",
    "url": "https://github.com/yanzhaohui1999"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanzhaohui1999/dsh-perf-hud.git"
  },
  "homepage": "https://github.com/yanzhaohui1999/dsh-perf-hud#readme",
  "bugs": {
    "url": "https://github.com/yanzhaohui1999/dsh-perf-hud/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.3.0-0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
